# Run with the repository root as context. Export this build's output to
# ocis/dist/binaries, then build Dockerfile.linux.amd64 (or its identical
# Dockerfile.remoteposix copy) using ocis/ as context.
FROM node:24.15.0-bookworm-slim AS web
WORKDIR /web
COPY web/ ./
RUN npm install --global pnpm@10.33.3 \
    && pnpm install --frozen-lockfile \
    && pnpm check:types \
    && pnpm build \
    && cp config/config.json.dist dist/config.json

FROM golang:1.26.0 AS toolchain

FROM amd64/alpine:3.24.2 AS build
RUN apk upgrade --no-cache \
    && apk add --no-cache build-base pkgconf bash git ca-certificates \
    && apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
       "vips=8.18.2-r0" "vips-dev=8.18.2-r0"
COPY --from=toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH \
    CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64
WORKDIR /source
COPY . .
COPY --from=web /web/dist/ services/web/assets/core/
ARG VERSION=8.2.0-remoteposix.3-alpine
ARG REVISION=unknown
# Match .make/release.mk, with VIPS enabled and SQLite's CGO implementation.
RUN go build -mod=vendor -buildvcs=false -buildmode=pie -trimpath \
    -tags netgo,disable_crypt,enable_vips \
    -ldflags "-s -w -X google.golang.org/protobuf/reflect/protoregistry.conflictPolicy=warn -X github.com/owncloud/ocis/v2/ocis-pkg/version.String=${REVISION} -X github.com/owncloud/ocis/v2/ocis-pkg/version.Tag=${VERSION} -X github.com/owncloud/ocis/v2/ocis-pkg/version.Date=$(date -u +%Y%m%d) -X github.com/owncloud/ocis/v2/ocis-pkg/config/defaults.BaseDataPathType=path -X github.com/owncloud/ocis/v2/ocis-pkg/config/defaults.BaseDataPathValue=/var/lib/ocis -X github.com/owncloud/ocis/v2/ocis-pkg/config/defaults.BaseConfigPathType=path -X github.com/owncloud/ocis/v2/ocis-pkg/config/defaults.BaseConfigPathValue=/etc/ocis" \
    -o /out/ocis-linux-amd64 ./ocis/cmd/ocis

FROM scratch AS binary
COPY --from=build /out/ocis-linux-amd64 /ocis-linux-amd64
